# ============================================================
# RICE POT Playwright BDD — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env — credentials must stay out of source control.
# ============================================================

# Application under test
BASE_URL=https://login.salesforce.com/?locale=in
SF_USERNAME=
SF_PASSWORD=

# Browser and execution mode
BROWSER=chromium
HEADLESS=true
ENV=qa

# Timeouts (milliseconds)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000

# Execution controls
# CUCUMBER_TAGS=@smoke
PARALLEL_WORKERS=2
RETRIES=0

# Reporting / diagnostics
SCREENSHOT_ON_FAILURE=true
VIDEO=off
TRACE=off
REPORT_PATH=reports
LOG_LEVEL=info

# Optional test-data overrides (invalid login only)
# INVALID_USERNAME=invalid.user@example.com
# INVALID_PASSWORD=InvalidPassword123!
