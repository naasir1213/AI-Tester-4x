{
  "name": "rice-pot-playwright-bdd",
  "version": "1.0.0",
  "description": "Enterprise Playwright + TypeScript + Cucumber BDD automation framework for Salesforce login",
  "private": true,
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags \"@smoke\"",
    "test:login": "cucumber-js --tags \"@login\"",
    "test:positive": "cucumber-js --tags \"@positive\"",
    "test:negative": "cucumber-js --tags \"@negative\"",
    "test:chromium": "cross-env BROWSER=chromium cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:parallel": "cross-env PARALLEL_WORKERS=2 cucumber-js",
    "test:dry": "cucumber-js --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "playwright": "^1.55.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
